{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api-csv-tools",
  "main": "frontend-worker.ts",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
